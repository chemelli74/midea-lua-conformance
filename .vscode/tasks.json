{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lua conformance: run tests",
      "detail": "Run the Lua protocol-conformance test suite (tests/).",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["-m", "pytest", "tests/"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lua conformance: regenerate reports",
      "detail": "Regenerate reports/MAPPING.md, reports/REPORT.md and reports/DISCREPANCIES.md.",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["-m", "midea_lua_conformance"],
      "problemMatcher": []
    }
  ]
}
